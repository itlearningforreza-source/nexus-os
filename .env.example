# Nexus OS Environment Configuration

# =============================================================================
# REQUIRED IN PRODUCTION - Generate strong random values for these
# =============================================================================

# Database
# Path to SQLite database file (use absolute path in production)
DATABASE_PATH=./data/nexus.db

# Authentication - CRITICAL: Must be a strong random string in production!
# Generate with: openssl rand -base64 32
# The app will REFUSE TO START in production if this is not set or uses a default value.
AUTH_SECRET=your-super-secret-random-string-here

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Admin Roles (comma-separated list of roles that have admin privileges)
ADMIN_ROLES=owner,admin

# Rate Limiting (per IP per minute)
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=10
RATE_LIMIT_PASSWORD=5

# Logging
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true

# Feature Flags (comma-separated, enables experimental features)
# ENABLED_FEATURES=ai,automation,webhooks

# Email Provider (for production email sending)
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=re_xxx
# EMAIL_FROM=noreply@yourdomain.com

# File Storage (for production file uploads)
# STORAGE_PROVIDER=s3
# S3_BUCKET=your-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY=xxx
# S3_SECRET_KEY=xxx

# Payment Provider (for billing/subscriptions)
# STRIPE_SECRET_KEY=sk_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# AI Provider (for real AI assistant)
# OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx

# =============================================================================
# DEVELOPMENT OVERRIDES (do not use in production)
# =============================================================================

# Set to 'true' to disable audit logging in development
# AUDIT_LOG_ENABLED=false

# Set to 'true' to use in-memory rate limiter (not for production)
# USE_MEMORY_RATE_LIMITER=true
