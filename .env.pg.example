# PostgreSQL Configuration (Managed Service)
# Get a free PostgreSQL from: https://neon.tech or https://supabase.com

# Neon.tech (Recommended - generous free tier)
# 1. Go to https://neon.tech
# 2. Create project -> Copy connection string
# 3. Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/nexus?sslmode=require

# Supabase (Alternative)
# 1. Go to https://supabase.com
# 2. Create project -> Settings -> Database -> Connection string
# 3. Format: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# Local PostgreSQL (if Docker available)
# DATABASE_URL=postgresql://nexus:nexus_secure_2024@localhost:5432/nexus

# For Neon.tech (replace with your actual connection string):
# DATABASE_URL=postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/nexus?sslmode=require

# Enable PostgreSQL mode
USE_POSTGRES=true

# Pool settings (optional)
PG_POOL_MAX=20
PG_IDLE_TIMEOUT=30000
PG_CONNECTION_TIMEOUT=2000
PG_SSL=true
